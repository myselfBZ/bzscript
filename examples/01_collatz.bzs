fun collatz(n) {
    var count = 0
    print("Starting sequence for:", n)
    
    while n != 1 {
        print(n)
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        count = count + 1
    }
    
    print(1)
    print("Reached 1 in", count, "steps!")
}

collatz(27)
